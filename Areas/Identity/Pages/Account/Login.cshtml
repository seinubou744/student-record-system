@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-wrapper">
        <div class="auth-brand-panel">
            <div class="auth-brand-badge">SQI</div>
            <p class="auth-eyebrow mb-2">Shukur Quran Institute</p>
            <h1 class="auth-title mb-3">Welcome back</h1>
            <p class="auth-text mb-4">
                Sign in to access the institute portal for administration, teaching, attendance, tests, and student progress.
            </p>

            <div class="auth-feature-list">
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Manage attendance and daily records</span>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Track Qur'an and Mutoon progress</span>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Access role-based dashboards securely</span>
                </div>
            </div>
        </div>

        <div class="auth-card shadow-sm">
            <div class="auth-card-header">
                <p class="login-eyebrow mb-2">Portal Login</p>
                <h2 class="login-title mb-2">Sign in to your account</h2>
                <p class="login-subtitle mb-0">Enter your email and password to continue.</p>
            </div>

            <form id="account" method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3" role="alert"></div>

                <div class="form-group mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Email" class="form-control login-input" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Password" class="form-control login-input" autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <a id="forgot-password" asp-page="./ForgotPassword" class="auth-inline-link">
                        Forgot password?
                    </a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary login-btn w-100">
                    Log in
                </button>

                <div class="login-links mt-4">
                   
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}