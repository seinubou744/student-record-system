@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <div class="login-shell">
        <div class="login-card">
            <div class="login-brand">
                <div class="login-brand-mark">Sh</div>
                <div class="login-brand-text">
                    <div class="login-brand-name">Shukur Quran Institute</div>
                    <div class="login-brand-subtitle">Student & Learning Management Portal</div>
                </div>
            </div>

            <div class="login-header">
                <h1 class="login-title">Sign in</h1>
                <p class="login-subtitle">Use your email or admission number and password to access the portal.</p>
            </div>

            <form id="account" method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Input.Login" class="form-label"></label>
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Login" class="text-danger"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="login-options">
                    <label asp-for="Input.RememberMe" class="login-checkbox">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 login-submit">
                    Sign in
                </button>

                <div class="login-help">
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}