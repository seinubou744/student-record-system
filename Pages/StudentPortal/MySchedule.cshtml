@page
@model StudentRecordSystem.Pages.StudentPortal.MyScheduleModel
@{
    ViewData["Title"] = "My Schedule";
}

<div class="mb-4">
    <h1 class="h3 mb-1">My Schedule</h1>
    <p class="text-muted mb-0">
        @if (Model.CurrentStudent is null)
        {
            @:Weekly timetable
        }
        else if (Model.CurrentStudent.Section is null || string.IsNullOrWhiteSpace(Model.CurrentStudent.Section.Name))
        {
            @($"{Model.CurrentStudent.ClassRoom?.Name} - No section assigned")
        }
        else
        {
            @($"{Model.CurrentStudent.ClassRoom?.Name} - {Model.CurrentStudent.Section.Name}")
        }
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mb-3">
        @Model.ErrorMessage
    </div>
}
else if (Model.Entries.Any())
{
    <div class="row g-3">
        @foreach (var item in Model.Entries)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 schedule-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge text-bg-success">@item.DayOfWeek</span>
                            <span class="text-muted small">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                        </div>
                        <h2 class="h6 mb-2">@item.Subject?.Name</h2>
                        <p class="mb-1"><strong>Teacher:</strong> @item.Teacher?.FullName</p>
                        <p class="mb-0"><strong>Room:</strong> @(string.IsNullOrWhiteSpace(item.RoomNumber) ? "-" : item.RoomNumber)</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    No schedule has been published for your class and section yet.
                </div>
            </div>
        </div>
    </div>
}