@page
@model StudentRecordSystem.Pages.StudentPortal.MatchModel
@{
    ViewData["Title"] = "Find Study Partner";
}

<div class="match-hero mb-4">
    <div>
        <p class="match-eyebrow mb-2">Peer Matching</p>
        <h1 class="match-title mb-2">Find a Study Partner</h1>
        <p class="match-text mb-0">
            Search for students with similar Quran or Mutoon progress so you can learn together privately.
        </p>
    </div>

    <div class="mb-3">
        <a asp-page="/StudentPortal/Requests" class="btn btn-outline-secondary">
            View My Requests
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success shadow-sm">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger shadow-sm">@Model.ErrorMessage</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label asp-for="SearchTerm" class="form-label">Search by student name</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Type a student name..." />
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-primary">Search Matches</button>
            </div>
        </form>
    </div>
</div>

@if (Model.CurrentStudent != null)
{
    <div class="alert alert-light border shadow-sm mb-4">
        <strong>Your student profile:</strong> @Model.CurrentStudent.FullName
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h3 class="section-title mb-1">Quran Matches</h3>
                        @if (Model.MyLatestQuran != null)
                        {
                            <p class="section-subtitle mb-0">
                                Your latest record:
                                Surah <strong>@Model.MyLatestQuran.SurahName</strong>,
                                From Ayah <strong>@(Model.MyLatestQuran.FromAyah ?? 0)</strong>,
                                To Ayah <strong>@(Model.MyLatestQuran.ToAyah ?? 0)</strong>
                            </p>
                        }
                        else
                        {
                            <p class="section-subtitle mb-0">No Quran record found for your profile.</p>
                        }
                    </div>
                </div>

                @if (Model.QuranMatches.Any())
                {
                    <div class="match-list">
                        @foreach (var item in Model.QuranMatches)
                        {
                            <div class="match-card">
                                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                    <div>
                                        <h5 class="mb-1">@item.StudentName</h5>
                                        <p class="text-muted mb-1">Class: @item.ClassRoomName</p>
                                        <p class="mb-1">Surah: <strong>@item.SurahName</strong></p>
                                        <p class="mb-1">From Ayah: <strong>@item.FromAyah</strong></p>
                                        <p class="mb-2">To Ayah: <strong>@item.ToAyah</strong></p>
                                        <small class="text-muted">@item.MatchReason</small>

                                        <form method="post" asp-page-handler="SendRequest" class="mt-3">
                                            <input type="hidden" name="receiverStudentId" value="@item.StudentId" />
                                            <input type="hidden" name="requestType" value="Quran" />
                                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />

                                            <div class="mb-2">
                                                <textarea name="RequestMessage" class="form-control" rows="2" placeholder="Optional message"></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-sm">
                                                Send Quran Request
                                            </button>
                                        </form>
                                    </div>

                                    <div class="score-badge">
                                        @item.MatchScore%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-box">
                        No Quran matches found.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h3 class="section-title mb-1">Mutoon Matches</h3>
                        @if (Model.MyLatestMutoon != null)
                        {
                            <p class="section-subtitle mb-0">
                                Your latest record:
                                <strong>@Model.MyLatestMutoon.MatnName</strong>
                                (@Model.MyLatestMutoon.FromPortion - @Model.MyLatestMutoon.ToPortion)
                            </p>
                        }
                        else
                        {
                            <p class="section-subtitle mb-0">No Mutoon record found for your profile.</p>
                        }
                    </div>
                </div>

                @if (Model.MutoonMatches.Any())
                {
                    <div class="match-list">
                        @foreach (var item in Model.MutoonMatches)
                        {
                            <div class="match-card">
                                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                    <div>
                                        <h5 class="mb-1">@item.StudentName</h5>
                                        <p class="text-muted mb-1">Class: @item.ClassRoomName</p>
                                        <p class="mb-1">Matn Name: <strong>@item.MatnName</strong></p>
                                        <p class="mb-2">Portion: <strong>@item.FromPortion - @item.ToPortion</strong></p>
                                        <small class="text-muted">@item.MatchReason</small>

                                        <form method="post" asp-page-handler="SendRequest" class="mt-3">
                                            <input type="hidden" name="receiverStudentId" value="@item.StudentId" />
                                            <input type="hidden" name="requestType" value="Mutoon" />
                                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />

                                            <div class="mb-2">
                                                <textarea name="RequestMessage" class="form-control" rows="2" placeholder="Optional message"></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-dark btn-sm">
                                                Send Mutoon Request
                                            </button>
                                        </form>
                                    </div>

                                    <div class="score-badge score-badge-dark">
                                        @item.MatchScore%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-box">
                        No Mutoon matches found.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .match-hero {
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
        color: white;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
    }

    .match-eyebrow {
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .85rem;
        opacity: .8;
    }

    .match-title {
        font-size: 2.2rem;
        font-weight: 800;
    }

    .match-text {
        max-width: 760px;
        color: rgba(255,255,255,.84);
        font-size: 1.05rem;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #111827;
    }

    .section-subtitle {
        color: #6b7280;
    }

    .match-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .match-card {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        background: #f8fafc;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .match-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(0,0,0,.06);
    }

    .score-badge {
        min-width: 72px;
        text-align: center;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 800;
        border-radius: 999px;
        padding: 10px 14px;
    }

    .score-badge-dark {
        background: #ede9fe;
        color: #6d28d9;
    }

    .empty-box {
        border: 1px dashed #d1d5db;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        color: #6b7280;
        background: #f9fafb;
    }

    @@media (max-width: 768px) {
        .match-title {
            font-size: 1.8rem;
        }

        .match-hero {
            padding: 24px;
        }
    }
</style>