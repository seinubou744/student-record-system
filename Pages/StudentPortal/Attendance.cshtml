@page
@model StudentRecordSystem.Pages.StudentPortal.AttendanceModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "My Attendance";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="eyebrow mb-2">Student Portal</p>
        <h1 class="hero-title mb-2">My Attendance</h1>
        <p class="hero-text mb-0">
            Review your saved attendance history and check your daily status records.
        </p>
    </div>

    @if (Model.CurrentStudent != null)
    {
        <div class="hero-badge">
            <span>@Model.CurrentStudent.FullName</span>
            @if (Model.CurrentStudent.ClassRoom != null)
            {
                <small class="d-block mt-1 opacity-75">@Model.CurrentStudent.ClassRoom.Name</small>
            }
        </div>
    }
</div>

@if (Model.AttendanceRecords.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h3 class="section-title mb-1">Attendance History</h3>
                    <p class="stat-text mb-0">Showing your most recent attendance records.</p>
                </div>
                <span class="badge text-bg-light px-3 py-2 fs-6">
                    @Model.AttendanceRecords.Count record(s)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Status</th>
                            <th class="pe-4">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AttendanceRecords)
                        {
                            var badgeClass = item.Status switch
                            {
                                AttendanceStatus.Present => "bg-success-subtle text-success-emphasis",
                                AttendanceStatus.Absent => "bg-danger-subtle text-danger-emphasis",
                                AttendanceStatus.Late => "bg-warning-subtle text-warning-emphasis",
                                _ => "bg-secondary-subtle text-secondary-emphasis"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @item.AttendanceDate.ToString("yyyy-MM-dd")
                                </td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass px-3 py-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="pe-4">
                                    @if (string.IsNullOrWhiteSpace(item.Remarks))
                                    {
                                        <span class="text-muted">No remarks</span>
                                    }
                                    else
                                    {
                                        @item.Remarks
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info border-0 shadow-sm">
        No attendance records found.
    </div>
}