@page
@model StudentRecordSystem.Pages.StudentPortal.TestDetailsModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "My Test Details";
}

<h1 class="mb-3">My Test Details</h1>

@if (Model.TestRecords.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Test Type</th>
                    <th>Range Details</th>
                    <th>Marks</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TestRecords)
                {
                    <tr>
                        <td>@item.TestDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.TestType</td>
                        <td>
                            @if (item.TestType == LearningRecordType.Quran)
                            {
                                <div>
                                    <strong>From:</strong> @item.FromSurah @if (item.FromAyah.HasValue) { <span>(Ayah @item.FromAyah)</span> }
                                </div>
                                <div>
                                    <strong>To:</strong> @item.ToSurah @if (item.ToAyah.HasValue) { <span>(Ayah @item.ToAyah)</span> }
                                </div>
                            }
                            else if (item.TestType == LearningRecordType.Mutoon)
                            {
                                <div>
                                    <strong>From Portion:</strong> @item.FromPortion
                                </div>
                                <div>
                                    <strong>To Portion:</strong> @item.ToPortion
                                </div>
                            }
                        </td>
                        <td>@item.Marks</td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No test records found.</div>
}