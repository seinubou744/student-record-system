@page
@model StudentRecordSystem.Pages_MutoonRecords.CreateModel

@{
    ViewData["Title"] = "Create Mutoon Record";
}

<h1>Create Mutoon Record</h1>

<h4>Mutoon Record</h4>
<hr />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css" />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.StudentId" class="control-label"></label>
                <select asp-for="MutoonRecord.StudentId" class="form-control" asp-items="Model.StudentList">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="MutoonRecord.StudentId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.MatnName" class="control-label"></label>
                <select asp-for="MutoonRecord.MatnName"
                        class="selectpicker form-control"
                        data-live-search="true"
                        data-size="10"
                        title="Search and select a matn"
                        asp-items="Model.MatnList">
                </select>
                <span asp-validation-for="MutoonRecord.MatnName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.FromPortion" class="control-label"></label>
                <input asp-for="MutoonRecord.FromPortion" class="form-control" />
                <span asp-validation-for="MutoonRecord.FromPortion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.ToPortion" class="control-label"></label>
                <input asp-for="MutoonRecord.ToPortion" class="form-control" />
                <span asp-validation-for="MutoonRecord.ToPortion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.RecordDate" class="control-label"></label>
                <input asp-for="MutoonRecord.RecordDate" class="form-control" />
                <span asp-validation-for="MutoonRecord.RecordDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MutoonRecord.Remarks" class="control-label"></label>
                <input asp-for="MutoonRecord.Remarks" class="form-control" />
                <span asp-validation-for="MutoonRecord.Remarks" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Mutoon Record" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>
}