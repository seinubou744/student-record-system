@page
@model StudentRecordSystem.Pages.TeacherPortal.AttendanceModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Take Attendance";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="eyebrow mb-2">Teacher Portal</p>
        <h1 class="hero-title mb-2">Take Attendance</h1>
        <p class="hero-text mb-0">
            Select a class, choose the attendance date, and save daily student attendance records for Shukur Quran Institute.
        </p>
    </div>

    <div class="hero-badge">
        <span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.DebugMessage))
{
    <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
        @Model.DebugMessage
    </div>
}

<div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm mb-4"></div>

<div class="card border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="section-title mb-1">Load Attendance Sheet</h3>
                <p class="stat-text mb-0">Choose the class and date to load students for attendance.</p>
            </div>
            @if (Model.Items.Any())
            {
                <span class="badge text-bg-light px-3 py-2 fs-6">
                    @Model.Items.Count student(s)
                </span>
            }
        </div>

        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Class</label>
                <select asp-for="ClassRoomId" asp-items="Model.TeacherClasses" class="form-select">
                    <option value="">-- Select Class --</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="AttendanceDate" class="form-label fw-semibold">Attendance Date</label>
                <input asp-for="AttendanceDate" type="date" class="form-control" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">Load Attendance</button>
            </div>
        </form>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="ClassRoomId" />
    <input type="hidden" asp-for="AttendanceDate" />

    <div class="card border-0">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-bottom">
                <div>
                    <h3 class="section-title mb-1">Attendance Register</h3>
                    <p class="stat-text mb-0">Review each student and update the correct status and remarks.</p>
                </div>

                @if (Model.Items.Any())
                {
                    <button type="submit" class="btn btn-primary">Save Attendance</button>
                }
            </div>

            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Admission No</th>
                                <th>Student Name</th>
                                <th style="min-width: 180px;">Status</th>
                                <th style="min-width: 240px;" class="pe-4">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold">@Model.Items[i].AdmissionNo</span>
                                        <input type="hidden" asp-for="Items[i].StudentId" />
                                        <input type="hidden" asp-for="Items[i].AdmissionNo" />
                                        <input type="hidden" asp-for="Items[i].FullName" />
                                        <input type="hidden" asp-for="Items[i].ClassRoomId" />
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@Model.Items[i].FullName</div>
                                    </td>
                                    <td>
                                        <select asp-for="Items[i].Status" class="form-select">
                                            <option value="@AttendanceStatus.Present">Present</option>
                                            <option value="@AttendanceStatus.Absent">Absent</option>
                                            <option value="@AttendanceStatus.Late">Late</option>
                                        </select>
                                    </td>
                                    <td class="pe-4">
                                        <input asp-for="Items[i].Remarks" class="form-control" placeholder="Optional remarks" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-4 border-top bg-light-subtle">
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4">Save Attendance</button>
                    </div>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="text-center py-5">
                        <h4 class="section-title mb-2">No students loaded</h4>
                        <p class="stat-text mb-0">
                            Select a class and date above, then click <strong>Load Attendance</strong> to begin.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</form>