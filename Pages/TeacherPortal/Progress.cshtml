@page
@model StudentRecordSystem.Pages.TeacherPortal.ProgressModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Qur'an & Mutoon Records";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="eyebrow mb-2">Teacher Portal</p>
        <h1 class="hero-title mb-2">Qur'an & Mutoon Records</h1>
        <p class="hero-text mb-0">
            Load a class, choose the record type and date, then save student learning progress and remarks for Shukur Quran Institute.
        </p>
    </div>

    <div class="hero-badge">
        <span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
        @Model.SuccessMessage
    </div>
}

<div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm mb-4 validation-summary-custom">
    <span class="fw-semibold">Please correct the following errors:</span>
</div>

<div class="card border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="section-title mb-1">Load Learning Records</h3>
                <p class="stat-text mb-0">Choose class, record type, and date to load the student list.</p>
            </div>

            @if (Model.Items.Any())
            {
                <span class="badge text-bg-light px-3 py-2 fs-6">
                    @Model.Items.Count student(s)
                </span>
            }
        </div>

        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Class</label>
                <select asp-for="ClassRoomId" asp-items="Model.TeacherClasses" class="form-select">
                    <option value="">-- Select Class --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Record Type</label>
                <select asp-for="RecordType" class="form-select">
                    <option value="@LearningRecordType.Quran">Qur'an</option>
                    <option value="@LearningRecordType.Mutoon">Mutoon</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="RecordDate" class="form-label fw-semibold">Record Date</label>
                <input asp-for="RecordDate" type="date" class="form-control" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">Load Records</button>
            </div>
        </form>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="ClassRoomId" />
    <input type="hidden" asp-for="RecordType" />
    <input type="hidden" asp-for="RecordDate" />

    <div class="card border-0">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-bottom">
                <div>
                    <h3 class="section-title mb-1">
                        @(Model.RecordType == LearningRecordType.Quran ? "Qur'an Progress Register" : "Mutoon Progress Register")
                    </h3>
                    <p class="stat-text mb-0">
                        Review each student row and save the correct progress details and remarks.
                    </p>
                </div>

                @if (Model.Items.Any())
                {
                    <button type="submit" class="btn btn-primary">Save Records</button>
                }
            </div>

            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Student ID</th>
                                <th>Name</th>

                                @if (Model.RecordType == LearningRecordType.Quran)
                                {
                                    <th style="min-width: 220px;">Surah</th>
                                    <th style="min-width: 140px;">From Ayah</th>
                                    <th style="min-width: 140px;">To Ayah</th>
                                }
                                else
                                {
                                    <th style="min-width: 220px;">Matn Name</th>
                                    <th style="min-width: 220px;">From Portion</th>
                                    <th style="min-width: 220px;">To Portion</th>
                                }

                                <th style="min-width: 240px;" class="pe-4">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold">@Model.Items[i].StudentCode</span>
                                        <input type="hidden" asp-for="Items[i].StudentId" />
                                        <input type="hidden" asp-for="Items[i].StudentCode" />
                                        <input type="hidden" asp-for="Items[i].StudentName" />
                                        <input type="hidden" asp-for="Items[i].ClassRoomId" />
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark">@Model.Items[i].StudentName</div>
                                    </td>

                                    @if (Model.RecordType == LearningRecordType.Quran)
                                    {
                                        <td>
                                            <select asp-for="Items[i].SurahName" asp-items="Model.SurahOptions" class="form-select">
                                                <option value="">-- Select Surah --</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input asp-for="Items[i].FromAyah" class="form-control" type="number" min="1" placeholder="From" />
                                        </td>
                                        <td>
                                            <input asp-for="Items[i].ToAyah" class="form-control" type="number" min="1" placeholder="To" />
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <input asp-for="Items[i].MatnName" class="form-control" placeholder="Enter matn name" />
                                        </td>
                                        <td>
                                            <input asp-for="Items[i].FromPortion" class="form-control" placeholder="Enter from portion" />
                                        </td>
                                        <td>
                                            <input asp-for="Items[i].ToPortion" class="form-control" placeholder="Enter to portion" />
                                        </td>
                                    }

                                    <td class="pe-4">
                                        <input asp-for="Items[i].Remarks" class="form-control" placeholder="Optional remarks" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-4 border-top bg-light-subtle">
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4">Save Records</button>
                    </div>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="text-center py-5">
                        <h4 class="section-title mb-2">No records loaded</h4>
                        <p class="stat-text mb-0">
                            Select a class, choose the record type and date, then click <strong>Load Records</strong> to begin.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}