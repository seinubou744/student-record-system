@page
@model StudentRecordSystem.Pages.Attendances.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>Attendance</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Attendance.StudentId" class="control-label"></label>
                <select asp-for="Attendance.StudentId" class ="form-control" asp-items="ViewBag.StudentId" aria-required="true"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Attendance.SubjectId" class="control-label"></label>
                <select asp-for="Attendance.SubjectId" class ="form-control" asp-items="ViewBag.SubjectId" aria-required="true"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Attendance.AttendanceDate" class="control-label"></label>
                <input asp-for="Attendance.AttendanceDate" class="form-control" aria-required="true"/>
                <span asp-validation-for="Attendance.AttendanceDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Attendance.IsPresent" /> @Html.DisplayNameFor(model => model.Attendance.IsPresent)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
