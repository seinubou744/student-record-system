@page
@model StudentRecordSystem.Pages.Attendances.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Attendance</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendance.Student)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendance.Student.AdmissionNo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendance.Subject)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendance.Subject.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendance.AttendanceDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendance.AttendanceDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendance.IsPresent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendance.IsPresent)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Attendance.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
