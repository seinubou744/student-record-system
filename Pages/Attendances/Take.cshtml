@page
@model StudentRecordSystem.Pages.Attendances.TakeModel
@{
    ViewData["Title"] = "Take Attendance";
}

<h1>Take Attendance</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="SelectedSubjectId" class="form-label">Subject</label>
        <select asp-for="SelectedSubjectId" asp-items="Model.SubjectList" class="form-control">
            <option value="">-- Select Subject --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="AttendanceDate" class="form-label">Date</label>
        <input asp-for="AttendanceDate" class="form-control" type="date" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Load Students</button>
    </div>
</form>

@if (Model.SelectedSubjectId.HasValue && !Model.StudentsToTake.Any())
{
    <div class="alert alert-warning">
        No students were found for the selected subject's class.
    </div>
}

@if (Model.StudentsToTake.Any())
{
    <form method="post">
        <input type="hidden" asp-for="SelectedSubjectId" />
        <input type="hidden" asp-for="AttendanceDate" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Admission No</th>
                    <th>Student Name</th>
                    <th>Present</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.StudentsToTake.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.StudentsToTake[i].AdmissionNo
                            <input type="hidden" asp-for="StudentsToTake[@i].StudentId" />
                            <input type="hidden" asp-for="StudentsToTake[@i].AdmissionNo" />
                            <input type="hidden" asp-for="StudentsToTake[@i].FullName" />
                        </td>
                        <td>@Model.StudentsToTake[i].FullName</td>
                        <td>
                            <input asp-for="StudentsToTake[@i].IsPresent" class="form-check-input" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success">Save Attendance</button>
    </form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}