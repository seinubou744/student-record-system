@page
@model StudentRecordSystem.Pages_Students.EditModel

@{
    ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>

<h4>Student Account</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Student.Id" />
            <input type="hidden" asp-for="Student.ApplicationUserId" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Student.AdmissionNo" class="control-label"></label>
                <input asp-for="Student.AdmissionNo" class="form-control" aria-required="true" />
                <span asp-validation-for="Student.AdmissionNo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Student.FullName" class="control-label"></label>
                <input asp-for="Student.FullName" class="form-control" aria-required="true" />
                <span asp-validation-for="Student.FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Student.ClassRoomId" class="control-label"></label>
                <select asp-for="Student.ClassRoomId"
                        class="form-control"
                        asp-items="ViewBag.ClassRoomId"
                        aria-required="true"
                        onchange="document.getElementById('loadSectionsButton').click();">
                    <option value="">-- Select Class Room --</option>
                </select>
                <span asp-validation-for="Student.ClassRoomId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Student.SectionId" class="control-label">Section</label>
                <select asp-for="Student.SectionId"
                        class="form-control"
                        asp-items="ViewBag.SectionId"
                        aria-required="true">
                    <option value="">-- Select Section --</option>
                </select>
                <span asp-validation-for="Student.SectionId" class="text-danger"></span>
            </div>

            <button id="loadSectionsButton"
                    type="submit"
                    asp-page-handler="LoadSections"
                    class="d-none"
                    formnovalidate>
            </button>

            <div class="form-group mt-3">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}