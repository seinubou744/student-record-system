@page "{id:int}"
@model StudentRecordSystem.Pages_Students.GeneratedLoginResultModel

@{
    ViewData["Title"] = "Generated Student Login";
}

<h1>Generated Student Login</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        @Model.SuccessMessage
    </div>
}

<div class="card p-3">
    <h4>Student Information</h4>
    <hr />
    <p><strong>Admission No:</strong> @Model.Student.AdmissionNo</p>
    <p><strong>Full Name:</strong> @Model.Student.FullName</p>
    <p><strong>Class Room:</strong> @Model.Student.ClassRoom?.Name</p>

    <hr />

    <h4>Generated Login Credentials</h4>
    <p><strong>Email:</strong> @Model.GeneratedEmail</p>
    <p><strong>Temporary Password:</strong> @Model.GeneratedPassword</p>

    <div class="alert alert-warning">
        Please copy these credentials now and give them to the student. You should later allow the student to change the password.
    </div>

    <a asp-page="./Index" class="btn btn-primary">Back to Students</a>
</div>