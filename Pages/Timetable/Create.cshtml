@page
@model StudentRecordSystem.Pages.Timetable.CreateModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Create Schedule";
}

<h1 class="h3 mb-2">Create Schedule</h1>
<p class="text-muted mb-4">Add a class timetable entry with section, subject, teacher, day, and time.</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Entry.ClassRoomId" class="form-label">Class</label>
                    <select asp-for="Entry.ClassRoomId" asp-items="Model.ClassRooms" class="form-select">
                        <option value="">Select class</option>
                    </select>
                    <span asp-validation-for="Entry.ClassRoomId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Entry.SectionId" class="form-label">Section</label>
                    <select asp-for="Entry.SectionId" asp-items="Model.Sections" class="form-select">
                        <option value="">Select section</option>
                    </select>
                    <span asp-validation-for="Entry.SectionId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Entry.SubjectId" class="form-label">Subject</label>
                    <select asp-for="Entry.SubjectId" asp-items="Model.Subjects" class="form-select">
                        <option value="">Select subject</option>
                    </select>
                    <span asp-validation-for="Entry.SubjectId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Entry.TeacherId" class="form-label">Teacher</label>
                    <select asp-for="Entry.TeacherId" asp-items="Model.Teachers" class="form-select">
                        <option value="">Select teacher</option>
                    </select>
                    <span asp-validation-for="Entry.TeacherId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Entry.DayOfWeek" class="form-label">Day</label>
                    <select asp-for="Entry.DayOfWeek" asp-items="Html.GetEnumSelectList<WeekDay>()" class="form-select">
                        <option value="">Select day</option>
                    </select>
                    <span asp-validation-for="Entry.DayOfWeek" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Entry.StartTime" class="form-label">Start time</label>
                    <input asp-for="Entry.StartTime" type="time" class="form-control" />
                    <span asp-validation-for="Entry.StartTime" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Entry.EndTime" class="form-label">End time</label>
                    <input asp-for="Entry.EndTime" type="time" class="form-control" />
                    <span asp-validation-for="Entry.EndTime" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Entry.RoomNumber" class="form-label">Room</label>
                    <input asp-for="Entry.RoomNumber" class="form-control" placeholder="Optional room number" />
                    <span asp-validation-for="Entry.RoomNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Entry.AcademicYear" class="form-label">Academic year</label>
                    <input asp-for="Entry.AcademicYear" class="form-control" placeholder="2026-2027" />
                    <span asp-validation-for="Entry.AcademicYear" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Schedule</button>
                <a asp-page="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}