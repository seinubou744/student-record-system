@page
@model StudentRecordSystem.Pages.Timetable.IndexModel
@{
    ViewData["Title"] = "Timetable Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Timetable Management</h1>
        <p class="text-muted mb-0">Create, edit, delete, and review schedule entries.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Create Schedule</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Section</th>
                        <th>Subject</th>
                        <th>Teacher</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Academic Year</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Entries)
                {
                    <tr>
                        <td>@item.ClassRoom?.Name</td>
                        <td>@item.Section?.Name</td>
                        <td>@item.Subject?.Name</td>
                        <td>@item.Teacher?.FullName</td>
                        <td>@item.DayOfWeek</td>
                        <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.RoomNumber) ? "-" : item.RoomNumber)</td>
                        <td>@item.AcademicYear</td>
                        <td class="text-nowrap">
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>