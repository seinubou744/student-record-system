@page
@model StudentRecordSystem.Pages_Subjects.CreateModel

@{
    ViewData["Title"] = "Create Subject";
}

<h1>Create Subject</h1>

<h4>Subject</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Subject.Name" class="control-label"></label>
                <input asp-for="Subject.Name" class="form-control" />
                <span asp-validation-for="Subject.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Subject.ClassRoomId" class="control-label">Class Room</label>
                <select asp-for="Subject.ClassRoomId" asp-items="Model.ClassRoomList" class="form-control">
                    <option value="">-- Select Class Room --</option>
                </select>
                <span asp-validation-for="Subject.ClassRoomId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}