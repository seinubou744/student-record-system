@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      dir="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shukur Quran Institute</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentRecordSystem.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
        <div class="container app-navbar-container">
            <a class="navbar-brand app-brand" asp-area="" asp-page="/Index">
                <span class="brand-logo-wrap">
                    <img src="~/images/institute-logo.png"
                         alt="Shukur Quran Institute Logo"
                         class="brand-logo" />
                </span>

                <span class="brand-text-wrap">
                    <span class="brand-text">Shukur Quran Institute</span>
                    <small class="brand-subtext">Student &amp; Learning Management Portal</small>
                </span>
            </a>

            <button class="navbar-toggler app-navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 app-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Students/Index">Students</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/ClassRooms/Index">Class Rooms</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Subjects/Index">Subjects</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/TeacherAttendance/Index">Teacher Attendance</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/CreateTeacher">Create Teacher</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/AssignTeacherClasses">Assign Classes</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Timetable/Index">Timetable Management</a>
                            </li>     
                            }

                        else if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/TeacherPortal/Index">Teacher Portal</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/TeacherPortal/Attendance">Attendance</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/TeacherPortal/Progress">Qur'an &amp; Mutoon</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/TeacherPortal/Tests">Tests</a>
                            </li>

                            <li class="nav-item">
                                    <a class="nav-link" asp-page="/TeacherPortal/MyTimetable">My Timetable</a>
                            </li>                       
                            }

                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentPortal/Attendance">My Attendance</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentPortal/QuranProgress">My Quran Progress</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentPortal/MutoonProgress">My Mutoon Progress</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentPortal/TestDetails">My Tests</a>
                            </li>
                             <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentPortal/MySchedule">My Schedule</a>
                            </li>
                        }
                    }
                </ul>

                <div class="app-toolbar">
                    <form method="post" asp-page="/SetLanguage" class="app-language-form">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <select name="culture" class="form-select form-select-sm language-select" onchange="this.form.submit()">
                            @if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
                            {
                                <option value="ar" selected>العربية</option>
                                <option value="en">English</option>
                            }
                            else
                            {
                                <option value="en" selected>English</option>
                                <option value="ar">العربية</option>
                            }
                        </select>
                    </form>

                    <div class="app-userbar">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>
    </header>

    <div class="app-shell">
        <main role="main" class="app-main container pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>&copy; 2026 - Shukur Quran Institute</div>
            <div>
                <a asp-area="" asp-page="/Privacy" class="footer-link">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>