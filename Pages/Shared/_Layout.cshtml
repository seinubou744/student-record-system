@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      dir="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentRecordSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentRecordSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">StudentRecordSystem</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
{
    <li class="nav-item">
        <a class="nav-link" asp-page="/Students/Index">Students</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/ClassRooms/Index">Class Rooms</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Subjects/Index">Subjects</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Admin/TeacherAttendance/Index">Manage Teacher Attendance</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Admin/CreateTeacher">Create Teacher Account</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Admin/AssignTeacherClasses">Assign Teacher Classes</a>
    </li>
}
                            else if (User.IsInRole("Teacher"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/TeacherPortal/Index">Teacher Portal</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/TeacherPortal/Attendance">Take Class Attendance</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/TeacherPortal/Progress">Qur'an &amp; Mutoon Records</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/TeacherPortal/Tests">Test Records</a>
                                </li>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/StudentPortal/Attendance">My Attendance</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/StudentPortal/QuranProgress">My Quran Progress</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/StudentPortal/MutoonProgress">My Mutoon Progress</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/StudentPortal/TestDetails">My Test Details</a>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>

            <form method="post" asp-page="/SetLanguage" class="d-flex align-items-center ms-3">
                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                <select name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                    @if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
                    {
                        <option value="ar" selected>العربية</option>
                        <option value="en">English</option>
                    }
                    else
                    {
                        <option value="en" selected>English</option>
                        <option value="ar">العربية</option>
                    }
                </select>
            </form>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - StudentRecordSystem - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>