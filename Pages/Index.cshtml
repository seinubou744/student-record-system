@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
    var isStudent = User.IsInRole("Student");
}

<div class="dashboard-hero mb-4">
    <div>
        @if (isAdmin)
        {
            <p class="eyebrow mb-2">Administration</p>
            <h1 class="hero-title mb-2">School Management Dashboard</h1>
            <p class="hero-text mb-0">
               Manage students, class rooms, subjects, teacher accounts, and teacher class assignments from one professional workspace.
            </p>
        }
        else if (isStudent)
        {
            <p class="eyebrow mb-2">Student Portal</p>
            <h1 class="hero-title mb-2">Welcome to Your Dashboard</h1>
            <p class="hero-text mb-0">
                View your attendance, Quran progress, and Mutoon progress in one place.
            </p>
        }
        else
        {
            <p class="eyebrow mb-2">Student Record System</p>
            <h1 class="hero-title mb-2">Welcome</h1>
        }
    </div>

    <div class="hero-badge">
        <span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>
</div>

@if (isAdmin)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Students</p>
                    <h2 class="stat-value">@Model.TotalStudents</h2>
                    <p class="stat-text">Registered student records.</p>
                    <a asp-page="/Students/Index" class="btn btn-primary w-100">Open Students</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Class Rooms</p>
                    <h2 class="stat-value">@Model.TotalClassRooms</h2>
                    <p class="stat-text">Configured class rooms.</p>
                    <a asp-page="/ClassRooms/Index" class="btn btn-outline-primary w-100">Open Class Rooms</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Subjects</p>
                    <h2 class="stat-value">@Model.TotalSubjects</h2>
                    <p class="stat-text">Subjects available in the system.</p>
                    <a asp-page="/Subjects/Index" class="btn btn-outline-primary w-100">Open Subjects</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h3 class="section-title mb-3">Quick Actions</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a asp-page="/Students/Create" class="quick-action-card">
                                <span class="quick-title">Add Student</span>
                                <span class="quick-text">Create a new student record.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Subjects/Create" class="quick-action-card">
                                <span class="quick-title">Create Subject</span>
                                <span class="quick-text">Add a subject under a class room.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/ClassRooms/Index" class="quick-action-card">
                                <span class="quick-title">Manage Classes</span>
                                <span class="quick-text">Open and manage class rooms.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/CreateTeacher" class="quick-action-card">
                                <span class="quick-title">Create Teacher</span>
                                <span class="quick-text">Create a new teacher account.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/AssignTeacherClasses" class="quick-action-card">
                                <span class="quick-title">Assign Teacher Classes</span>
                                <span class="quick-text">Assign teachers to class rooms.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/TeacherAttendance/Index" class="quick-action-card">
                                <span class="quick-title">Teacher Attendance</span>
                                <span class="quick-text">View and manage teacher attendance.</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h3 class="section-title mb-3">Management</h3>
                    <div class="d-grid gap-3">
                        <a asp-page="/Students/Index" class="btn btn-light text-start dashboard-link">Student Management</a>
                        <a asp-page="/Subjects/Index" class="btn btn-light text-start dashboard-link">Subject Management</a>
                        <a asp-page="/ClassRooms/Index" class="btn btn-light text-start dashboard-link">Class Room Management</a>
                        <a asp-page="/Admin/CreateTeacher" class="btn btn-light text-start dashboard-link">Teacher Accounts</a>
                        <a asp-page="/Admin/AssignTeacherClasses" class="btn btn-light text-start dashboard-link">Teacher Class Assignments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (isStudent)
{
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Attendance</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your attendance records.</p>
                    <a asp-page="/StudentPortal/Attendance" class="btn btn-primary w-100">Open Attendance</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Quran</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your Quran learning progress.</p>
                    <a asp-page="/StudentPortal/QuranProgress" class="btn btn-success w-100">Open Quran Progress</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="stat-label">Mutoon</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your Mutoon learning progress.</p>
                    <a asp-page="/StudentPortal/MutoonProgress" class="btn btn-dark w-100">Open Mutoon Progress</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
    <div class="card stat-card border-0 shadow-sm h-100">
        <div class="card-body">
            <p class="stat-label">Matching</p>
            <h2 class="stat-value">Peer</h2>
            <p class="stat-text">Find another student with similar Quran or Mutoon progress.</p>
            <a asp-page="/StudentPortal/Match" class="btn btn-warning w-100">Find Study Partner</a>
        </div>
    </div>
</div>
    </div>
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
        color: #fff;
        border-radius: 20px;
        padding: 32px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
    }

    .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .hero-title {
        font-size: 2.3rem;
        font-weight: 800;
    }

    .hero-text {
        max-width: 720px;
        color: rgba(255,255,255,0.82);
        font-size: 1.05rem;
    }

    .hero-badge span {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.16);
        padding: 10px 14px;
        border-radius: 999px;
        display: inline-block;
        font-weight: 600;
    }

    .stat-card {
        border-radius: 18px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 30px rgba(0,0,0,0.08);
    }

    .stat-label {
        color: #6b7280;
        font-size: 0.9rem;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 10px;
        color: #111827;
    }

    .stat-text {
        color: #6b7280;
        min-height: 48px;
        margin-bottom: 18px;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #111827;
    }

    .quick-action-card {
        display: block;
        text-decoration: none;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        height: 100%;
        transition: all 0.2s ease;
    }

    .quick-action-card:hover {
        background: #eff6ff;
        border-color: #bfdbfe;
        transform: translateY(-3px);
        text-decoration: none;
    }

    .quick-title {
        display: block;
        font-weight: 700;
        color: #111827;
        margin-bottom: 6px;
    }

    .quick-text {
        display: block;
        color: #6b7280;
        font-size: 0.95rem;
    }

    .dashboard-link {
        border-radius: 14px;
        padding: 14px 16px;
        border: 1px solid #e5e7eb;
        font-weight: 600;
    }

    .dashboard-link:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 1.8rem;
        }

        .dashboard-hero {
            padding: 24px;
        }
    }
</style>