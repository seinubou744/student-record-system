@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
    var isStudent = User.IsInRole("Student");
    var isTeacher = User.IsInRole("Teacher");
}

<div class="dashboard-hero mb-4">
    <div>
        @if (isAdmin)
        {
            <p class="eyebrow mb-2">Administration</p>
            <h1 class="hero-title mb-2">Shukur Quran Institute Dashboard</h1>
            <p class="hero-text mb-0">
                Manage students, class rooms, subjects, teacher accounts, and teacher assignments from one professional workspace.
            </p>
        }
        else if (isTeacher)
        {
            <p class="eyebrow mb-2">Teacher Portal</p>
            <h1 class="hero-title mb-2">Teaching and Progress Dashboard</h1>
            <p class="hero-text mb-0">
                Record attendance, manage Qur'an and Mutoon progress, and update student test results from one organized portal.
            </p>
        }
        else if (isStudent)
        {
            <p class="eyebrow mb-2">Student Portal</p>
            <h1 class="hero-title mb-2">Welcome to Shukur Quran Institute</h1>
            <p class="hero-text mb-0">
                View your attendance, Qur'an progress, Mutoon progress, and study support tools in one place.
            </p>
        }
        else
        {
            <p class="eyebrow mb-2">Shukur Quran Institute</p>
            <h1 class="hero-title mb-2">Student and Learning Management Portal</h1>
            <p class="hero-text mb-0">
                A secure and modern platform designed to support Qur'anic education, student development, academic excellence, and institutional administration.
            </p>
        }
    </div>

    <div class="hero-badge">
        <span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>
</div>

@if (isAdmin)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Students</p>
                    <h2 class="stat-value">@Model.TotalStudents</h2>
                    <p class="stat-text">Registered student records in the institute.</p>
                    <a asp-page="/Students/Index" class="btn btn-primary w-100">Open Students</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Class Rooms</p>
                    <h2 class="stat-value">@Model.TotalClassRooms</h2>
                    <p class="stat-text">Configured class rooms and teaching groups.</p>
                    <a asp-page="/ClassRooms/Index" class="btn btn-outline-primary w-100">Open Class Rooms</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Subjects</p>
                    <h2 class="stat-value">@Model.TotalSubjects</h2>
                    <p class="stat-text">Subjects and learning areas available in the system.</p>
                    <a asp-page="/Subjects/Index" class="btn btn-outline-primary w-100">Open Subjects</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 h-100">
                <div class="card-body p-4">
                    <h3 class="section-title mb-3">Quick Actions</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a asp-page="/Students/Create" class="quick-action-card">
                                <span class="quick-title">Add Student</span>
                                <span class="quick-text">Create a new student record.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Subjects/Create" class="quick-action-card">
                                <span class="quick-title">Create Subject</span>
                                <span class="quick-text">Add a subject under a class room.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/ClassRooms/Index" class="quick-action-card">
                                <span class="quick-title">Manage Classes</span>
                                <span class="quick-text">Open and manage class rooms.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/CreateTeacher" class="quick-action-card">
                                <span class="quick-title">Create Teacher</span>
                                <span class="quick-text">Create a new teacher account.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/AssignTeacherClasses" class="quick-action-card">
                                <span class="quick-title">Assign Teacher Classes</span>
                                <span class="quick-text">Assign teachers to class rooms.</span>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-page="/Admin/TeacherAttendance/Index" class="quick-action-card">
                                <span class="quick-title">Teacher Attendance</span>
                                <span class="quick-text">View and manage teacher attendance records.</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 h-100">
                <div class="card-body p-4">
                    <h3 class="section-title mb-3">Management</h3>
                    <div class="d-grid gap-3">
                        <a asp-page="/Students/Index" class="btn btn-light text-start dashboard-link">Student Management</a>
                        <a asp-page="/Subjects/Index" class="btn btn-light text-start dashboard-link">Subject Management</a>
                        <a asp-page="/ClassRooms/Index" class="btn btn-light text-start dashboard-link">Class Room Management</a>
                        <a asp-page="/Admin/CreateTeacher" class="btn btn-light text-start dashboard-link">Teacher Accounts</a>
                        <a asp-page="/Admin/AssignTeacherClasses" class="btn btn-light text-start dashboard-link">Teacher Class Assignments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (isTeacher)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Attendance</p>
                    <h2 class="stat-value">Daily</h2>
                    <p class="stat-text">Take and review class attendance for assigned students.</p>
                    <a asp-page="/TeacherPortal/Attendance" class="btn btn-primary w-100">Open Attendance</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Qur'an & Mutoon</p>
                    <h2 class="stat-value">Records</h2>
                    <p class="stat-text">Update learning progress and remarks for each student.</p>
                    <a asp-page="/TeacherPortal/Progress" class="btn btn-outline-primary w-100">Open Progress</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Tests</p>
                    <h2 class="stat-value">Results</h2>
                    <p class="stat-text">Enter and manage test results for Qur'an or Mutoon.</p>
                    <a asp-page="/TeacherPortal/Tests" class="btn btn-outline-primary w-100">Open Tests</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0">
        <div class="card-body p-4">
            <h3 class="section-title mb-3">Teacher Quick Access</h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-page="/TeacherPortal/Index" class="quick-action-card">
                        <span class="quick-title">Teacher Portal</span>
                        <span class="quick-text">Go to your teaching dashboard and overview.</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-page="/TeacherPortal/Attendance" class="quick-action-card">
                        <span class="quick-title">Take Attendance</span>
                        <span class="quick-text">Mark student attendance by class and date.</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-page="/TeacherPortal/Progress" class="quick-action-card">
                        <span class="quick-title">Update Records</span>
                        <span class="quick-text">Save Qur'an and Mutoon progress correctly.</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (isStudent)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Attendance</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your attendance records and daily presence.</p>
                    <a asp-page="/StudentPortal/Attendance" class="btn btn-primary w-100">Open Attendance</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Qur'an</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your Qur'an memorization and learning progress.</p>
                    <a asp-page="/StudentPortal/QuranProgress" class="btn btn-success w-100">Open Qur'an Progress</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Mutoon</p>
                    <h2 class="stat-value">My</h2>
                    <p class="stat-text">View your Mutoon progress and remarks.</p>
                    <a asp-page="/StudentPortal/MutoonProgress" class="btn btn-dark w-100">Open Mutoon Progress</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 h-100">
                <div class="card-body">
                    <p class="stat-label">Matching</p>
                    <h2 class="stat-value">Peer</h2>
                    <p class="stat-text">Find another student with similar Qur'an or Mutoon progress.</p>
                    <a asp-page="/StudentPortal/Match" class="btn btn-warning w-100">Find Study Partner</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0">
        <div class="card-body p-4">
            <h3 class="section-title mb-3">Student Quick Access</h3>
            <div class="row g-3">
                <div class="col-md-3">
                    <a asp-page="/StudentPortal/Index" class="quick-action-card">
                        <span class="quick-title">Student Portal</span>
                        <span class="quick-text">Open your dashboard and portal overview.</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-page="/StudentPortal/Attendance" class="quick-action-card">
                        <span class="quick-title">Attendance</span>
                        <span class="quick-text">Review your daily attendance record.</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-page="/StudentPortal/QuranProgress" class="quick-action-card">
                        <span class="quick-title">Qur'an Progress</span>
                        <span class="quick-text">See your memorization and revision progress.</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-page="/StudentPortal/Match" class="quick-action-card">
                        <span class="quick-title">Study Match</span>
                        <span class="quick-text">Find a suitable study partner.</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="home-dual-card">
                <div class="row g-0 h-100">
                    <div class="col-lg-6">
                        <div class="split-panel">
                            <p class="home-panel-subtitle mb-2">English Panel</p>
                            <h3 class="home-panel-heading">Welcome to Shukur Quran Institute</h3>
                            <p class="home-widget-text">
                                <span class="portal-intro-highlight">Student Record Management System</span> is a secure and modern platform designed to support Qur'anic education, student development, academic excellence, and institutional administration.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="split-panel arabic-panel">
                            <p class="home-panel-subtitle mb-2">الواجهة العربية</p>
                            <h3 class="home-panel-heading">مرحبًا بكم في معهد شكر لتحفيظ القرآن الكريم</h3>
                            <p class="home-widget-text">
                                <span class="portal-intro-highlight">نظام إدارة سجلات الطلاب</span> هو منصة حديثة وآمنة تهدف إلى دعم التعليم القرآني، وتنظيم بيانات الطلاب، ومتابعة الحفظ والمراجعة، وتعزيز التميز الأكاديمي والإدارة المؤسسية.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card home-access-card border-0">
                <div class="card-body">
                    <h3 class="section-title mb-3">Authorized Access</h3>
                    <p class="home-widget-text mb-3">
                        Access to this portal is limited to approved users. Please sign in using your assigned credentials.
                    </p>

                    <div class="d-grid gap-2">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light">Login</a>
                        <a asp-page="/Privacy" class="btn btn-outline-light">Privacy</a>
                    </div>

                    <ul class="home-feature-list">
                        <li><span class="home-feature-dot"></span><span>Role-based access for Admin, Teacher, and Student portals.</span></li>
                        <li><span class="home-feature-dot"></span><span>Secure academic and learning record management.</span></li>
                        <li><span class="home-feature-dot"></span><span>Bilingual presentation for English and Arabic users.</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 home-info-card mb-4">
        <div class="card-body">
            <h3 class="section-title mb-3">Join Shukur Quran Institute</h3>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="quick-action-card h-100">
                        <span class="quick-title">Quality Qur'anic Education</span>
                        <span class="quick-text">Support strong memorization, revision, and guided learning.</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="quick-action-card h-100">
                        <span class="quick-title">Islamic Character</span>
                        <span class="quick-text">Promote discipline, good manners, and faith-centered development.</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="quick-action-card h-100">
                        <span class="quick-title">Academic Monitoring</span>
                        <span class="quick-text">Follow progress through reports, attendance, and structured records.</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="quick-action-card h-100">
                        <span class="quick-title">Safe Environment</span>
                        <span class="quick-text">Provide a secure and organized educational environment for all learners.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card home-quote-card border-0 h-100">
                <div class="card-body">
                    <h3 class="section-title mb-3">Qur'anic Reminder</h3>
                    <blockquote>
                        <p>“My Lord! Increase me in knowledge.”</p>
                        <footer>Surah Taha (20:114)</footer>
                    </blockquote>
                    <blockquote>
                        <p>“Allah will elevate those of you who are faithful, and those gifted with knowledge in rank.”</p>
                        <footer>Surah Al-Mujadila (58:11)</footer>
                    </blockquote>
                    <blockquote>
                        <p>“The best among you are those who learn the Qur’an and teach it.”</p>
                        <footer> Prophet Muhammad ﷺ (Sahih al-Bukhari)</footer>
                    </blockquote>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card home-quote-card border-0 h-100 arabic-panel">
                <div class="card-body">
                    <h3 class="section-title mb-3">تذكير قرآني وهدي نبوي</h3>
                    <blockquote dir="rtl">
                        <p>﴿ وَقُل رَّبِّ زِدْنِي عِلْمًا ﴾</p>
                        <footer>سورة طه: 114</footer>
                    </blockquote>
                    <blockquote dir="rtl">
                        <p>﴿ يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ ﴾</p>
                        <footer>سورة المجادلة: 11</footer>
                    </blockquote>
                    <blockquote dir="rtl">
                        <p>«خيركم من تعلم القرآن وعلمه»</p>
                        <footer>رواه البخاري</footer>
                    </blockquote>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card home-info-card border-0 h-100">
                <div class="card-body">
                    <h3 class="section-title mb-3">Portal Services</h3>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">Student Records</div>
                                <p class="guest-service-text">Manage student data, enrollment details, and institutional records efficiently.</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">Learning Progress</div>
                                <p class="guest-service-text">Track Qur'an memorization, Mutoon development, and educational performance.</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">Teachers and Administration</div>
                                <p class="guest-service-text">Support teachers, attendance workflows, assignments, and administrative oversight.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card home-info-card border-0 h-100 arabic-panel">
                <div class="card-body">
                    <h3 class="section-title mb-3">خدمات النظام</h3>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">إدارة سجلات الطلاب</div>
                                <p class="guest-service-text">تنظيم بيانات الطلاب، وبيانات القبول، والفصول، والسجلات المؤسسية بكفاءة عالية.</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">متابعة الحفظ والتقدم</div>
                                <p class="guest-service-text">متابعة حفظ القرآن، والمراجعة، وتطور المتون، والأداء التعليمي بشكل منظم.</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="guest-service-card">
                                <div class="guest-service-title">إدارة المعلمين والإدارة</div>
                                <p class="guest-service-text">دعم المعلمين، وسير الحضور، وتوزيع المهام، والمتابعة الإدارية المستمرة.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-4">
            <div class="home-info-card">
                <div class="card-body">
                    <div class="home-widget-icon">01</div>
                    <h3 class="home-widget-title">Student Records Management</h3>
                    <p class="home-widget-text">
                        Organize and manage student profiles, admissions, class assignments, and academic records in one professional environment.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="home-info-card">
                <div class="card-body">
                    <div class="home-widget-icon">02</div>
                    <h3 class="home-widget-title">Qur'an Tracking</h3>
                    <p class="home-widget-text">
                        Monitor memorization, revision, progress remarks, and student learning development with accuracy and clarity.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-xl-4">
            <div class="home-info-card">
                <div class="card-body">
                    <div class="home-widget-icon">03</div>
                    <h3 class="home-widget-title">Attendance and Reports</h3>
                    <p class="home-widget-text">
                        Track attendance, support discipline, review performance reports, and strengthen institutional follow-up.
                    </p>
                </div>
            </div>
        </div>
    </div>
}