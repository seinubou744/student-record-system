@page
@model StudentRecordSystem.Pages.Admin.AssignTeacherClassesModel
@{
    ViewData["Title"] = "Assign Teacher Classes";
}

<h2 class="mb-4">Assign Classes to Teacher</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="get" class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label">Teacher</label>
        <select asp-for="TeacherUserId" asp-items="Model.Teachers" class="form-select">
            <option value="">-- Select Teacher --</option>
        </select>
    </div>
    <div class="col-md-6 d-flex align-items-end gap-2 flex-wrap">
        <button type="submit" class="btn btn-outline-primary">Load Classes</button>

        @if (!string.IsNullOrWhiteSpace(Model.TeacherUserId))
        {
            <a asp-page="/Admin/ResetUserPassword"
               asp-route-userId="@Model.TeacherUserId"
               class="btn btn-warning">
                Reset Teacher Password
            </a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.TeacherUserId))
{
    <form method="post">
        <input type="hidden" asp-for="TeacherUserId" />

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Class Assignments</strong>

                <a asp-page="/Admin/ResetUserPassword"
                   asp-route-userId="@Model.TeacherUserId"
                   class="btn btn-sm btn-warning">
                    Reset Password
                </a>
            </div>

            <div class="card-body">
                @if (Model.AvailableClasses.Any())
                {
                    <div class="row">
                        @foreach (var item in Model.AvailableClasses)
                        {
                            <div class="col-md-4 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedClassRoomIds"
                                           value="@item.Id"
                                           id="class_@item.Id"
                                           @(item.Assigned ? "checked" : null) />
                                    <label class="form-check-label" for="class_@item.Id">
                                        @item.Name
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No classes found. Please create classes first.
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save Assignments</button>
        </div>
    </form>
}