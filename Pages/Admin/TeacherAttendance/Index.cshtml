@page
@model StudentRecordSystem.Pages.Admin.TeacherAttendance.IndexModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Manage Teacher Attendance";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="eyebrow mb-2">Admin Panel</p>
        <h1 class="hero-title mb-2">Manage Teacher Attendance</h1>
        <p class="hero-text mb-0">
            Review, filter, and manage attendance records submitted by teachers.
        </p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h3 class="section-title mb-1">Filter Records</h3>
                <p class="stat-text mb-0">Use the filters below to narrow down attendance records.</p>
            </div>
        </div>

        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label asp-for="ClassRoomId" class="form-label fw-semibold">Class</label>
                <select asp-for="ClassRoomId" asp-items="Model.ClassRooms" class="form-select">
                    <option value="">All Classes</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="AttendanceDate" class="form-label fw-semibold">Attendance Date</label>
                <input asp-for="AttendanceDate" type="date" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="SearchTerm" class="form-label fw-semibold">Student Name</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Search by student name" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-bottom">
            <div>
                <h3 class="section-title mb-1">Attendance Records</h3>
                <p class="stat-text mb-0">Showing the latest teacher attendance entries.</p>
            </div>

            <span class="badge text-bg-light px-3 py-2 fs-6">
                @Model.Records.Count record(s)
            </span>
        </div>

        @if (Model.Records.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Class</th>
                            <th>Admission No</th>
                            <th>Student</th>
                            <th>Status</th>
                            <th>Teacher</th>
                            <th>Remarks</th>
                            <th class="pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Records)
                        {
                            var badgeClass = item.Status switch
                            {
                                AttendanceStatus.Present => "bg-success-subtle text-success-emphasis",
                                AttendanceStatus.Absent => "bg-danger-subtle text-danger-emphasis",
                                AttendanceStatus.Late => "bg-warning-subtle text-warning-emphasis",
                                _ => "bg-secondary-subtle text-secondary-emphasis"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @item.AttendanceDate.ToString("yyyy-MM-dd")
                                </td>
                                <td>@item.ClassRoom?.Name</td>
                                <td>@item.Student?.AdmissionNo</td>
                                <td>@item.Student?.FullName</td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass px-3 py-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.TeacherUser?.FullName</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Remarks))
                                    {
                                        <span class="text-muted">No remarks</span>
                                    }
                                    else
                                    {
                                        @item.Remarks
                                    }
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4">
                <div class="alert alert-info border-0 shadow-sm mb-0">
                    No attendance records found for the selected filters.
                </div>
            </div>
        }
    </div>
</div>