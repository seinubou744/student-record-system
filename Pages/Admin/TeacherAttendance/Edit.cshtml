@page "{id:int}"
@model StudentRecordSystem.Pages.Admin.TeacherAttendance.EditModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Edit Teacher Attendance";
}

<h1 class="mb-3">Edit Teacher Attendance</h1>

<form method="post">
    <input type="hidden" asp-for="TeacherAttendanceRecord.Id" />
    <input type="hidden" asp-for="TeacherAttendanceRecord.TeacherUserId" />
    <input type="hidden" asp-for="TeacherAttendanceRecord.CreatedAt" />

    <div class="mb-3">
        <label asp-for="TeacherAttendanceRecord.StudentId" class="form-label"></label>
        <select asp-for="TeacherAttendanceRecord.StudentId" asp-items="Model.StudentList" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherAttendanceRecord.ClassRoomId" class="form-label"></label>
        <select asp-for="TeacherAttendanceRecord.ClassRoomId" asp-items="Model.ClassList" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherAttendanceRecord.AttendanceDate" class="form-label"></label>
        <input asp-for="TeacherAttendanceRecord.AttendanceDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="TeacherAttendanceRecord.Status" class="form-label"></label>
        <select asp-for="TeacherAttendanceRecord.Status" class="form-select">
            <option value="@AttendanceStatus.Present">Present</option>
            <option value="@AttendanceStatus.Absent">Absent</option>
            <option value="@AttendanceStatus.Late">Late</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherAttendanceRecord.Remarks" class="form-label"></label>
        <input asp-for="TeacherAttendanceRecord.Remarks" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back</a>
</form>