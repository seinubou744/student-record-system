@page "{id:int}"
@model StudentRecordSystem.Pages.Admin.TeacherAttendance.DeleteModel
@using StudentRecordSystem.Models
@{
    ViewData["Title"] = "Delete Teacher Attendance";
}

<div class="dashboard-hero mb-4">
    <div>
        <p class="eyebrow mb-2">Admin Panel</p>
        <h1 class="hero-title mb-2">Delete Teacher Attendance</h1>
        <p class="hero-text mb-0">
            Confirm before permanently removing this teacher attendance record.
        </p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="alert alert-warning border-0 shadow-sm mb-4">
            Are you sure you want to delete this attendance record? This action cannot be undone.
        </div>

        @{
            var badgeClass = Model.TeacherAttendanceRecord.Status switch
            {
                AttendanceStatus.Present => "bg-success-subtle text-success-emphasis",
                AttendanceStatus.Absent => "bg-danger-subtle text-danger-emphasis",
                AttendanceStatus.Late => "bg-warning-subtle text-warning-emphasis",
                _ => "bg-secondary-subtle text-secondary-emphasis"
            };
        }

        <dl class="row mb-4">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">@Model.TeacherAttendanceRecord.Student?.FullName</dd>

            <dt class="col-sm-3">Admission No</dt>
            <dd class="col-sm-9">@Model.TeacherAttendanceRecord.Student?.AdmissionNo</dd>

            <dt class="col-sm-3">Class</dt>
            <dd class="col-sm-9">@Model.TeacherAttendanceRecord.ClassRoom?.Name</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.TeacherAttendanceRecord.AttendanceDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge rounded-pill @badgeClass px-3 py-2">
                    @Model.TeacherAttendanceRecord.Status
                </span>
            </dd>

            <dt class="col-sm-3">Teacher</dt>
            <dd class="col-sm-9">@Model.TeacherAttendanceRecord.TeacherUser?.FullName</dd>

            <dt class="col-sm-3">Remarks</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.TeacherAttendanceRecord.Remarks))
                {
                    <span class="text-muted">No remarks</span>
                }
                else
                {
                    @Model.TeacherAttendanceRecord.Remarks
                }
            </dd>
        </dl>

        <form method="post" class="d-flex flex-wrap gap-2">
            <input type="hidden" asp-for="TeacherAttendanceRecord.Id" />
            <button type="submit" class="btn btn-danger">Delete Record</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>