@page "{id:int}"
@model StudentRecordSystem.Pages.Admin.TeacherAttendance.DeleteModel
@{
    ViewData["Title"] = "Delete Teacher Attendance";
}

<h1 class="mb-3">Delete Teacher Attendance</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this attendance record?
</div>

<dl class="row">
    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.TeacherAttendanceRecord.Student?.FullName</dd>

    <dt class="col-sm-3">Admission No</dt>
    <dd class="col-sm-9">@Model.TeacherAttendanceRecord.Student?.AdmissionNo</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.TeacherAttendanceRecord.AttendanceDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.TeacherAttendanceRecord.Status</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="TeacherAttendanceRecord.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>